# ---------------------------------------------------------------------------
# USD/KHR Tracker — configuration
# Copy to .env and export the values (or pass them via your process manager).
# Every variable is optional; the defaults below are what the app uses.
# ---------------------------------------------------------------------------

# --- HTTP ------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# --- Source ----------------------------------------------------------------
SOURCE_URL=https://www.wingbank.com.kh/en/exchange-rate
# Mirrors tried when the primary URL is unreachable. `{url}` is replaced with
# the (encoded) source URL. Leave empty to disable.
FALLBACK_SOURCES=https://r.jina.ai/{url}
# Optional JSON endpoints probed before the HTML page (comma separated).
WING_API_ENDPOINTS=
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36 USD-KHR-Tracker/1.0
ACCEPT_LANGUAGE=en-US,en;q=0.9
FETCH_TIMEOUT_MS=20000

# --- Tracking --------------------------------------------------------------
PRIMARY_PAIR=USD/KHR
POLL_INTERVAL_MIN=15
REFRESH_MIN_GAP_SEC=10
BACKOFF_AFTER=3
BACKOFF_CAP_MIN=120

# --- Storage ---------------------------------------------------------------
DATA_DIR=./data
MIN_STORE_INTERVAL_SEC=30
MAX_OBSERVATIONS=500000
# 0 = keep history forever. 365 = drop samples older than a year (log is rewritten).
RETENTION_DAYS=0
USE_SEED=true
# auto = writable disk -> read/write, serverless/read-only disk -> read-only.
# Force with `fs` or `readonly` (Vercel is always read-only: see README).
STORE_MODE=auto

# --- Daily snapshots (graph data) -------------------------------------------
# One open/high/low/close row per calendar day, written to data/daily.jsonl.
# 420 = UTC+7 (Asia/Phnom_Penh, no DST) so days start at Cambodian midnight.
DAILY_TZ_OFFSET_MIN=420
# Which pairs get persisted daily rows: empty = the primary pair, `*` = all.
DAILY_SNAPSHOT_PAIRS=
# 0 = keep daily rows forever. 730 = two years of daily history.
DAILY_RETENTION_DAYS=0

# --- Serverless deployment (Vercel) -----------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/*.
CRON_SECRET=
# Optional: let the daily cron commit its snapshot back to this repository
# (GitHub Contents API, needs contents:write). Without it the cron still
# scrapes and reports, but cannot persist on a read-only filesystem.
GITHUB_DATA_TOKEN=
GITHUB_REPO=your-name/USD-KHR_Data_From_WingBank
GITHUB_BRANCH=main
# Files the snapshot job maintains in git.
DAILY_FILE=data/daily.jsonl
DAILY_CSV_FILE=data/usd-khr-daily.csv

# --- Simulation (demo / offline hosts ONLY — rows are flagged everywhere) ---
ALLOW_SIMULATION=false
SIMULATE_ON_FAILURE=false
SIMULATE_BACKFILL_DAYS=0
SIMULATE_BACKFILL_INTERVAL_MIN=60
SIMULATE_SEED_VALUE=4054
SIMULATE_VOLATILITY_PCT=0.05

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
# stderr keeps CLI output pipeable (--export / --format json). Use stdout if
# your platform only collects stdout.
LOG_STREAM=stderr
